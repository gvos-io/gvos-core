# Local demo credentials — copy to deploy/.env (gitignored) before compose up:
#   cp deploy/.env.example deploy/.env
# Production: replace every value; see docs/operations-manual.md §0.

# Compose port overrides
GVOS_API_PORT=28080
GVOS_SIP_PORT=15060
GVOS_PG_PORT=15432
GVOS_NATS_PORT=14222
GVOS_MINIO_PORT=29000
GVOS_MINIO_CONSOLE_PORT=29001

# PostgreSQL
POSTGRES_USER=gvos
POSTGRES_PASSWORD=gvos_dev
POSTGRES_DB=gvos
GVOS_DB_DSN=postgres://gvos:gvos_dev@postgres:5432/gvos?sslmode=disable

# NATS (bus auth — required once authentication is enabled)
GVOS_NATS_USER=gvos
GVOS_NATS_PASSWORD=gvos-demo-nats

# Internal / admin demo tokens (never reuse in production)
GVOS_INTERNAL_TOKEN=dev-internal-token
GVOS_ADMIN_TOKEN=dev-admin-token

# MinIO (recording profile only)
MINIO_ROOT_USER=gvos
MINIO_ROOT_PASSWORD=gvos-minio-secret
